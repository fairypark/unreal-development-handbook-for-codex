              "to_band",
              "delta_range",
              "unit",
              "transition_rule"
            ],
            "properties": {
              "transition_id": {
                "$ref": "#/$defs/stableId"
              },
              "requirement_ids": {
                "$ref": "#/$defs/idArray"
              },
              "from_band": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "to_band": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "delta_range": {
                "$ref": "#/$defs/numericRange"
              },
              "unit": {
                "enum": [
                  "METERS",
                  "CENTIMETERS"
                ]
              },
