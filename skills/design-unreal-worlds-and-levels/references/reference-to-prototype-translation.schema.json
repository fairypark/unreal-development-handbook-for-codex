                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "water_and_bridges": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement_ids",
            "applicability",
            "not_applicable_reason",
            "features"
          ],
          "properties": {
            "requirement_ids": {
              "$ref": "#/$defs/idArray"
            },
            "applicability": {
              "enum": [
                "APPLICABLE",
                "NOT_APPLICABLE"
              ]
            },
            "not_applicable_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "feature_id",
                  "requirement_ids",
                  "feature_type",
                  "role",
                  "continuity_rule"
                ],
                "properties": {
                  "feature_id": {
                    "$ref": "#/$defs/stableId"
                  },
                  "requirement_ids": {
                    "$ref": "#/$defs/idArray"
                  },
                  "feature_type": {
                    "enum": [
                      "WATER_BODY",
                      "BANK",
                      "CROSSING",
                      "BRIDGE",
                      "APPROACH"
                    ]
                  },
                  "role": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "continuity_rule": {
                    "$ref": "#/$defs/nonEmptyString"
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "applicability": {
                    "const": "APPLICABLE"
                  }
                }
              },
              "then": {
                "properties": {
                  "not_applicable_reason": {
                    "type": "null"
                  },
                  "features": {
                    "minItems": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "not_applicable_reason": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "features": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        },
        "shaded_spaces": {
          "$ref": "#/$defs/spaceSet"
        },
        "intentional_voids": {
          "$ref": "#/$defs/spaceSet"
        },
        "hierarchy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement_ids",
            "focal_order",
            "required_relations"
          ],
          "properties": {
            "requirement_ids": {
              "$ref": "#/$defs/idArray"
            },
            "focal_order": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/stableId"
              }
            },
            "required_relations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "prohibited_silhouettes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
