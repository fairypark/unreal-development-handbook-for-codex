              "projection": {
                "enum": [
                  "PERSPECTIVE",
                  "ORTHOGRAPHIC"
                ]
              },
              "resolution": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1
